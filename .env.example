# Copiar a .env y completar con los valores reales.
PORT=4000
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta
# Supabase: conexión por pooler (pgbouncer) para la app...
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
# ...y conexión directa para Prisma (db push / migraciones).
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"
